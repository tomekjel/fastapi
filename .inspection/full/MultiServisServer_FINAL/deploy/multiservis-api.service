[Unit]
Description=Multi-Servis FastAPI backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=multiservis
Group=multiservis
WorkingDirectory=/opt/multiservis
EnvironmentFile=/opt/multiservis/.env
ExecStart=/opt/multiservis/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
